      <PARAM name="DPTYPE" datatype="char" arraysize="*" value="">
        <DESCRIPTION>Specify value of dataproduct_type field</DESCRIPTION>
        <VALUES type="actual">
          <OPTION value="cube"/>
          <OPTION value="image"/>
        </VALUES>
      </PARAM>
      <PARAM name="EXPTIME" datatype="double" arraysize="2" unit="sec" value="" xtype="interval">
