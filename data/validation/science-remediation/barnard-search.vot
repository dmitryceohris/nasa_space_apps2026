    <PARAM name="standardID" datatype="char" arraysize="*" value="ivo://ivoa.net/std/SIA#query-2.0"/>
    <PARAM name="accessURL" datatype="char" arraysize="*" value="https://irsa.ipac.caltech.edu/SIA"/>
    <PARAM name="resourceIdentifier" datatype="char" arraysize="*" value="ivo://irsa.ipac/SIA"/>
  </RESOURCE>
  <RESOURCE type="results">
    <INFO name="QUERY_STATUS" value="OK"/>
    <TABLE>
      <FIELD name="s_ra" datatype="double" ID="col_0" ucd="pos.eq.ra" unit="deg" utype="obscore:char.spatialaxis.coverage.location.coord.position2d.value2.c1">
        <DESCRIPTION>Central Spatial Position in ICRS Right ascension</DESCRIPTION>
      </FIELD>
      <FIELD name="s_dec" datatype="double" ID="col_1" ucd="pos.eq.dec" unit="deg" utype="obscore:char.spatialaxis.coverage.location.coord.position2d.value2.c2">
        <DESCRIPTION>Central Spatial Position in ICRS Declination</DESCRIPTION>
      </FIELD>
      <FIELD name="facility_name" datatype="char" arraysize="*" ID="col_2" ucd="meta.id;instr.tel" utype="obscore:provenance.obsconfig.facility.name">
        <DESCRIPTION>Name of telescope used to acquire observation</DESCRIPTION>
      </FIELD>
      <FIELD name="instrument_name" datatype="char" arraysize="*" ID="col_3" ucd="meta.id;instr" utype="obscore:provenance.obsconfig.instrument.name">
        <DESCRIPTION>Name of instrument used to acquire observation</DESCRIPTION>
      </FIELD>
      <FIELD name="dataproduct_subtype" datatype="char" arraysize="*" ID="col_4" ucd="meta.code" utype="caom2:artifact.producttype">
        <DESCRIPTION>Product type (e.g. science, calibration, auxiliary, preview, info)</DESCRIPTION>
      </FIELD>
      <FIELD name="calib_level" datatype="short" ID="col_5" ucd="meta.code;obs.calib" utype="obscore:obsdataset.caliblevel">
        <DESCRIPTION>Calibration level of the observation: in {0, 1, 2, 3, 4}</DESCRIPTION>
      </FIELD>
      <FIELD name="dataproduct_type" datatype="char" arraysize="*" ID="col_6" ucd="meta.id" utype="obscore:obsdataset.dataproducttype">
        <DESCRIPTION>Data product (file content) primary type</DESCRIPTION>
      </FIELD>
      <FIELD name="energy_bandpassname" datatype="char" arraysize="*" ID="col_7" utype="caom2:Energy.bandpassName">
        <DESCRIPTION>Collection-specific name for energy band (e.g. filter name)</DESCRIPTION>
      </FIELD>
      <FIELD name="energy_emband" datatype="char" arraysize="*" ID="col_8" utype="caom2:Energy.emBand">
        <DESCRIPTION>Generic name for energy band (Radio,Millimeter,Infrared,Optical,...)</DESCRIPTION>
      </FIELD>
      <FIELD name="obs_id" datatype="char" arraysize="*" ID="col_9" ucd="meta.id" utype="obscore:dataid.observationid">
        <DESCRIPTION>Internal ID given by the ObsTAP service</DESCRIPTION>
      </FIELD>
      <FIELD name="s_resolution" datatype="double" ID="col_10" irsa_format="12.6f" precision="F6" ucd="pos.angResolution" unit="arcsec" utype="obscore:char.spatialaxis.resolution.refval.value">
        <DESCRIPTION>Spatial resolution (FWHM)</DESCRIPTION>
      </FIELD>
      <FIELD name="em_min" datatype="double" ID="col_11" irsa_format="10.5e" precision="E5" ucd="em.wl;stat.min" unit="m" utype="obscore:char.spectralaxis.coverage.bounds.limits.lolimit">
        <DESCRIPTION>Lower bound on energy axis (barycentric wavelength)</DESCRIPTION>
      </FIELD>
      <FIELD name="em_max" datatype="double" ID="col_12" irsa_format="10.5e" precision="E5" ucd="em.wl;stat.max" unit="m" utype="obscore:char.spectralaxis.coverage.bounds.limits.hilimit">
        <DESCRIPTION>Upper bound on energy axis (barycentric wavelength)</DESCRIPTION>
      </FIELD>
      <FIELD name="em_res_power" datatype="double" ID="col_13" irsa_format="12.6f" precision="F6" ucd="spect.resolution" utype="obscore:char.spectralaxis.resolution.resolpower.refval">
        <DESCRIPTION>Spectral resolving power (R)</DESCRIPTION>
      </FIELD>
      <FIELD name="proposal_title" datatype="char" arraysize="*" ID="col_14" utype="caom2:Proposal.title">
        <DESCRIPTION>Proposal title</DESCRIPTION>
      </FIELD>
      <FIELD name="access_url" datatype="char" arraysize="*" ID="col_15" ucd="meta.ref.url" utype="obscore:access.reference">
        <DESCRIPTION>URI for the physical artifact</DESCRIPTION>
      </FIELD>
      <FIELD name="access_format" datatype="char" arraysize="*" ID="col_16" ucd="meta.code.mime" utype="obscore:access.format">
        <DESCRIPTION>Content-Type of the representation at uri</DESCRIPTION>
      </FIELD>
      <FIELD name="access_estsize" datatype="long" ID="col_17" ucd="phys.size;meta.file" unit="kbyte" utype="obscore:access.size">
        <DESCRIPTION>Estimated size of the download at uri</DESCRIPTION>
      </FIELD>
      <FIELD name="t_exptime" datatype="double" ID="col_18" irsa_format="12.6f" precision="F6" ucd="time.duration;obs.exposure" unit="s" utype="obscore:char.timeaxis.coverage.support.extent">
        <DESCRIPTION>Exposure time per pixel</DESCRIPTION>
      </FIELD>
      <FIELD name="s_region" datatype="char" arraysize="*" ID="col_19" ucd="pos.outline;obs.field" unit="deg" utype="obscore:char.spatialaxis.coverage.support.area">
        <DESCRIPTION>AstroCoordArea Region covered in STC</DESCRIPTION>
      </FIELD>
      <FIELD name="obs_collection" datatype="char" arraysize="*" ID="col_20" ucd="meta.id" utype="obscore:dataid.collection">
        <DESCRIPTION>Data collection this observation belongs to</DESCRIPTION>
      </FIELD>
      <FIELD name="obs_intent" datatype="char" arraysize="*" ID="col_21" utype="caom2:ObservationIntentType">
        <DESCRIPTION>Intended purpose of data (one of: science, calibration)</DESCRIPTION>
      </FIELD>
      <FIELD name="algorithm_name" datatype="char" arraysize="*" ID="col_22" utype="caom2:Algorithm">
        <DESCRIPTION>Algorithm that defines the observation</DESCRIPTION>
      </FIELD>
      <FIELD name="facility_keywords" datatype="char" arraysize="*" ID="col_23" utype="caom2:Telescope.keywords">
        <DESCRIPTION>Telescope keywords formatted as a JSON string</DESCRIPTION>
      </FIELD>
      <FIELD name="instrument_keywords" datatype="char" arraysize="*" ID="col_24" utype="caom2:Instrument.keywords">
        <DESCRIPTION>Instrument keywords formatted as a JSON string</DESCRIPTION>
      </FIELD>
      <FIELD name="environment_photometric" datatype="boolean" ID="col_25" utype="caom2:Environment.photometric">
        <DESCRIPTION>Conditions were photometric (0=false, 1=true)</DESCRIPTION>
      </FIELD>
      <FIELD name="proposal_id" datatype="char" arraysize="*" ID="col_26" ucd="meta.id;obs.proposal" utype="obscore:provenance.proposal.identifier">
        <DESCRIPTION>Collection-specific unique proposal identifier</DESCRIPTION>
      </FIELD>
      <FIELD name="proposal_pi" datatype="char" arraysize="*" ID="col_27" utype="caom2:Proposal.pi">
        <DESCRIPTION>Proposal principal investigator</DESCRIPTION>
      </FIELD>
      <FIELD name="proposal_project" datatype="char" arraysize="*" ID="col_28" utype="caom2:Proposal.project">
        <DESCRIPTION>Project that created/acquired the observation</DESCRIPTION>
      </FIELD>
      <FIELD name="target_name" datatype="char" arraysize="*" ID="col_29" ucd="meta.id;src" utype="obscore:target.name">
        <DESCRIPTION>Name of intended target</DESCRIPTION>
      </FIELD>
      <FIELD name="target_type" datatype="char" arraysize="*" ID="col_30" utype="caom2:Target.type">
        <DESCRIPTION>Classification of intended target (&apos;object&apos; or &apos;field&apos;)</DESCRIPTION>
      </FIELD>
      <FIELD name="target_standard" datatype="boolean" ID="col_31" utype="caom2:Target.standard">
        <DESCRIPTION>Intended target is a standard (0=false, 1=true)</DESCRIPTION>
      </FIELD>
      <FIELD name="target_moving" datatype="boolean" ID="col_32" utype="caom2:Target.moving">
        <DESCRIPTION>Intended target is moving (0=false, 1=true)</DESCRIPTION>
      </FIELD>
      <FIELD name="target_keywords" datatype="char" arraysize="*" ID="col_33" utype="caom2:Target.keywords">
        <DESCRIPTION>Target keywords formatted as a JSON string</DESCRIPTION>
      </FIELD>
      <FIELD name="obs_release_date" datatype="char" arraysize="*" ID="col_34" ucd="time.release" utype="obscore:Curation.releaseDate" xtype="timestamp">
        <DESCRIPTION>Timestamp of date the data becomes publicly available</DESCRIPTION>
      </FIELD>
      <FIELD name="s_xel1" datatype="long" ID="col_35" ucd="meta.number" utype="obscore:char.spatialaxis.numbins1">
        <DESCRIPTION>Dimensions (number of pixels) along first spatial axis</DESCRIPTION>
      </FIELD>
      <FIELD name="s_xel2" datatype="long" ID="col_36" ucd="meta.number" utype="obscore:char.spatialaxis.numbins2">
        <DESCRIPTION>Dimensions (number of pixels) along second spatial axis</DESCRIPTION>
      </FIELD>
      <FIELD name="s_pixel_scale" datatype="double" ID="col_37" irsa_format="7.3f" precision="F3" unit="arcsec" utype="phys.angSize;instr.pixel">
        <DESCRIPTION>Sample (pixel) size on spatial axes</DESCRIPTION>
      </FIELD>
      <FIELD name="position_timedependent" datatype="boolean" ID="col_38" utype="caom2:Position.timeDependent">
        <DESCRIPTION>Position is time-dependent (0=false, 1=true)</DESCRIPTION>
      </FIELD>
      <FIELD name="t_min" datatype="double" ID="col_39" irsa_format="12.6f" precision="F6" ucd="time.start;obs.exposure" unit="d" utype="obscore:char.timeaxis.coverage.bounds.limits.starttime">
        <DESCRIPTION>Lower bound on time axis (Modified Julian Day)</DESCRIPTION>
      </FIELD>
