          <OPTION value="SPHEREx"/>
          <OPTION value="SPIRIT III"/>
          <OPTION value="Spitzer"/>
          <OPTION value="Spitzer Space Telescope"/>
          <OPTION value="Stratospheric Observatory For Infrared Astronomy"/>
